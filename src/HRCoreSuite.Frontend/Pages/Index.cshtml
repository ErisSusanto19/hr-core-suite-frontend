@page
@model IndexModel
@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="text-center">
    <h1 class="display-4">HR Core Suite Dashboard</h1>
    <p>Data Master Perusahaan</p>
</div>

<hr />

<div class="mb-3">
    <a asp-page="/Employees/Manage" class="btn btn-primary">Tambah Pegawai Baru</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}
else
{
    <div class="mb-5">
        <h3>Master Data Pegawai</h3>
        <table class="table table-striped table-hover table-sm">
            <thead class="thead-dark">
                <tr>
                    <th>No. Pegawai</th>
                    <th>Nama Pegawai</th>
                    <th>Nama Cabang</th>
                    <th>Jabatan</th>
                    <th>Mulai Kontrak</th>
                    <th>Selesai Kontrak</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Employees.Any())
                {
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td>@employee.EmployeeNumber</td>
                            <td>@employee.Name</td>
                            <td>@employee.BranchName</td>
                            <td>@employee.PositionName</td>
                            <td>@employee.ContractStartDate.ToString("dd MMM yyyy")</td>
                            <td>@employee.ContractEndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-page="/Employees/Manage" asp-route-id="@employee.Id" class="btn btn-sm btn-info">Edit</a>
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@employee.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('Apakah Anda yakin ingin menghapus pegawai ini?');"> Hapus
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">Tidak ada data pegawai yang ditemukan.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* <div class="row">
        <div class="col-md-6">
            <h3>Master Data Cabang</h3>
